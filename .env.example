# Neon serverless Postgres — pooled connection string from the Neon dashboard.
# The deployed app and local dev both read the dictionary from here; the raw
# XML in data/ is only ever touched by scripts/import-jmdict.ts.
DATABASE_URL=

# Clerk — https://dashboard.clerk.com, enable the Google social connection.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
